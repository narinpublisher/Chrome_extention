{
  "manifest_version": 3,
  "name": "My Synced To-Do List",
  "version": "1.0",
  "description": "A dark-mode New Tab dashboard that syncs your tasks.",
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "permissions": ["storage"],
  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}